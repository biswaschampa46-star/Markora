# PostgreSQL database URL (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase Auth - used for the admin panel login
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Storage - product images. OPTIONAL but recommended:
# Server-only key from Project Settings -> API -> service_role. When set,
# image uploads/deletes bypass RLS (no storage policies needed). Without it,
# the anon key is used and you must add the storage policies from the README.
# Keep this out of NEXT_PUBLIC_* - it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (Resend) - OPTIONAL, emails are skipped when missing
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Recipient that gets notified about new orders
ADMIN_NOTIFY_EMAIL=admin@markora.com
# Sender address shown on emails (must be verified in Resend; free tier uses onboarding@resend.dev)
NOTIFY_EMAIL_FROM=Markora <onboarding@resend.dev>

# Store mobile number shown to customers for bKash / Nagad payment (OPTIONAL)
NEXT_PUBLIC_STORE_PHONE=01XXXXXXXXX
